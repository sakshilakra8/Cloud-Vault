POSTGRES_DB=shardvault
POSTGRES_USER=shardvault
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-a-long-random-password
DOMAIN=files.example.com
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-password
CORS_ALLOWED_ORIGINS=https://files.example.com
# Generate JWT_SECRET with at least 32 random bytes, base64 encoded.
JWT_SECRET=replace-with-base64-encoded-32-byte-secret
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
SPRING_PROFILES_ACTIVE=dev
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/shardvault
SPRING_DATASOURCE_USERNAME=shardvault
SPRING_DATASOURCE_PASSWORD=change-me
SHARDVAULT_DEFAULT_QUOTA_BYTES=5368709120
SHARDVAULT_JWT_ISSUER=shardvault-local
# Base64-encoded 32-byte AES KEKs. MASTER_KEY_B64 is treated as version 1;
# versioned names allow future key rotation without rewrapping every file at once.
MASTER_KEY_B64=replace-with-base64-encoded-32-byte-key
MASTER_KEY_B64_V1=replace-with-base64-encoded-32-byte-key
MASTER_KEY_B64_V2=replace-with-base64-encoded-next-32-byte-key

# Storage provider config refs. A providers.config_ref value of LOCAL_DEV
# resolves these env vars. Secrets live in env, never in providers rows.
LOCAL_DEV_ROOT=./data/local-provider
LOCAL_DEV_RATE_LIMIT_HINT=dev-only

# A providers.config_ref value of MINIO_DEV resolves these env vars.
MINIO_DEV_ENDPOINT_OVERRIDE=http://localhost:9000
MINIO_DEV_REGION=us-east-1
MINIO_DEV_BUCKET=shardvault
MINIO_DEV_PATH_STYLE_ACCESS=true
MINIO_DEV_ACCESS_KEY_ID=minioadmin
MINIO_DEV_SECRET_ACCESS_KEY=change-me-minio-password

# Backblaze B2 S3 Compatible API. Register provider type BACKBLAZE_B2 with
# config_ref=BACKBLAZE_DEV in the providers table/admin API.
BACKBLAZE_DEV_ENDPOINT_OVERRIDE=https://s3.us-west-004.backblazeb2.com
BACKBLAZE_DEV_REGION=us-west-004
BACKBLAZE_DEV_BUCKET=replace-with-b2-bucket
BACKBLAZE_DEV_PATH_STYLE_ACCESS=true
BACKBLAZE_DEV_ACCESS_KEY_ID=replace-with-b2-key-id
BACKBLAZE_DEV_SECRET_ACCESS_KEY=replace-with-b2-application-key

# Cloudflare R2 S3 Compatible API. Register provider type CLOUDFLARE_R2 with
# config_ref=CLOUDFLARE_R2_DEV. R2 requires region 'auto'.
CLOUDFLARE_R2_DEV_ENDPOINT_OVERRIDE=https://replace-with-account-id.r2.cloudflarestorage.com
CLOUDFLARE_R2_DEV_REGION=auto
CLOUDFLARE_R2_DEV_BUCKET=replace-with-r2-bucket
CLOUDFLARE_R2_DEV_PATH_STYLE_ACCESS=true
CLOUDFLARE_R2_DEV_ACCESS_KEY_ID=replace-with-r2-access-key-id
CLOUDFLARE_R2_DEV_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key

# GCS uses Application Default Credentials. Point this at a service account
# key file locally, or use the attached workload identity in production.
GCS_DEV_BUCKET=replace-with-gcs-bucket
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# Experimental Telegram replica provider. The bot must be a member of a
# private channel and chat ID must identify that channel (often -100...).
TELEGRAM_DEV_BOT_TOKEN=replace-with-bot-token
TELEGRAM_DEV_CHAT_ID=replace-with-private-channel-id
TELEGRAM_DEV_RATE_LIMIT_HINT=experimental-low-reliability-replica-only
